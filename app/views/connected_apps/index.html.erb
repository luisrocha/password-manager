<% content_for :title, "Connected apps" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<%
  primary_button_class = "inline-flex min-h-11 items-center justify-center rounded-md border border-teal-700 bg-teal-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-800"
  secondary_button_class = "inline-flex min-h-11 items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
  danger_button_class = "inline-flex min-h-11 items-center justify-center rounded-md border border-red-200 bg-red-50 px-4 py-2 text-sm font-semibold text-red-700 hover:bg-red-100"
%>

<main class="mx-auto w-full max-w-4xl px-4 py-6 sm:px-6 lg:px-8">
  <header class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-teal-700">Vault access</p>
      <h1 class="mt-1 text-3xl font-semibold text-slate-950">Connected apps</h1>
    </div>
    <%= link_to "Back to vault", credentials_path, class: secondary_button_class %>
  </header>

  <% if notice.present? %>
    <p class="mb-4 rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-900" data-extension-connect-target="notification"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800" data-extension-connect-target="notification"><%= alert %></p>
  <% end %>
  <p class="hidden" data-extension-connect-target="status"></p>

  <div class="grid gap-5">
  <section class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
    <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
      <div>
        <h2 class="text-lg font-semibold text-slate-950">Browser extension</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Connect the browser extension to this vault.
        </p>
      </div>
      <button
        type="button"
        class="<%= primary_button_class %>"
        data-extension-connect-target="button"
        data-action="extension-connect#connectExtension"
      >Connect Extension</button>
    </div>
  </section>

  <section
    class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm"
    data-controller="mobile-app-setup"
    data-mobile-app-setup-pairing-url-value="<%= connected_apps_mobile_pairings_path %>"
  >
    <div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-start">
      <div>
        <h2 class="text-lg font-semibold text-slate-950">Set up mobile app</h2>
        <p class="mt-2 text-sm leading-6 text-slate-600">
          Create a short-lived pairing code, then enter it in the mobile app.
        </p>
      </div>
      <button
        type="button"
        class="<%= primary_button_class %>"
        data-action="mobile-app-setup#createPairingCode"
        data-mobile-app-setup-target="button"
      >Create pairing code</button>
    </div>

    <p class="hidden" data-mobile-app-setup-target="status"></p>
    <div class="mt-5 hidden rounded-md border border-slate-200 bg-slate-50 p-4" data-mobile-app-setup-target="panel">
      <p
        class="mt-2 font-mono text-3xl font-bold tracking-widest text-slate-950"
        data-mobile-app-setup-target="code"
      ></p>
    </div>
  </section>

  <section class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
    <div>
      <h2 class="text-lg font-semibold text-slate-950">Mobile devices</h2>
      <p class="mt-2 text-sm leading-6 text-slate-600">
        Paired mobile apps can sync encrypted vault data until access is revoked.
      </p>
    </div>

    <% if @mobile_devices.any? %>
      <div class="mt-5 divide-y divide-slate-200 rounded-md border border-slate-200">
        <% @mobile_devices.each do |device| %>
          <div class="grid gap-4 p-4 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center">
            <div>
              <p class="font-semibold text-slate-950"><%= device.name %></p>
              <p class="mt-1 text-sm text-slate-600">
                Connected <%= time_tag device.created_at, device.created_at.to_fs(:long) %>
                <% if device.last_used_at.present? %>
                  · Last synced <%= time_tag device.last_used_at, device.last_used_at.to_fs(:long) %>
                <% end %>
              </p>
              <% if device.revoked_at.present? %>
                <p class="mt-1 text-sm font-semibold text-red-700">
                  Revoked <%= time_tag device.revoked_at, device.revoked_at.to_fs(:long) %>
                </p>
              <% end %>
            </div>

            <% if device.revoked_at.blank? %>
              <%= button_to "Revoke access",
                connected_apps_mobile_device_path(device),
                method: :delete,
                class: danger_button_class,
                form: { data: { turbo_confirm: "Revoke this mobile app's sync access?" } } %>
            <% else %>
              <span class="inline-flex min-h-11 items-center justify-center rounded-md bg-slate-100 px-4 py-2 text-sm font-semibold text-slate-500">Revoked</span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="mt-5 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600">
        No mobile devices are connected yet.
      </p>
    <% end %>
  </section>
  </div>
</main>
