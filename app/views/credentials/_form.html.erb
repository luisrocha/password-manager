<% credential_form_data = {
  controller: "credential-form",
  action: "submit->credential-form#submit",
} %>
<% credential_form_data[:credential_form_encrypted_payload_value] = credential.encrypted_secret_payload if credential.encrypted_secret_payload.present? %>

<%= form_with model: credential, data: credential_form_data do |f| %>
  <div class="grid">
    <%= f.label :name %>
    <%= f.text_field :name, required: true %>

    <%= f.label :domain %>
    <%= f.text_field :domain, required: true %>

    <%= f.label :category %>
    <%= f.select :category, Credential::CATEGORIES %>

    <label for="credential_username_plaintext">Username</label>
    <input id="credential_username_plaintext" type="text" required data-credential-form-target="username">

    <label for="credential_password_plaintext">Password</label>
    <% if local_assigns[:password_generator] %>
      <div
        class="password-generator-field"
        data-controller="password-generator"
        data-password-generator-hidden-class="hidden"
      >
        <div class="password-input-actions">
          <input
            id="credential_password_plaintext"
            type="password"
            required
            data-credential-form-target="password"
            data-password-generator-target="password"
          >
          <button
            type="button"
            class="icon-button password-visibility-button"
            style="--show-icon-url: url('<%= asset_path("icons/eye.svg") %>'); --hide-icon-url: url('<%= asset_path("icons/eye-off.svg") %>')"
            aria-label="Show password"
            title="Show password"
            data-password-generator-target="visibilityButton"
            data-action="password-generator#toggleVisibility"
          ></button>
          <button
            type="button"
            class="icon-button generate-password-button"
            style="--icon-url: url('<%= asset_path("icons/sparkles.svg") %>')"
            aria-expanded="false"
            aria-label="Generate password"
            title="Generate password"
            data-password-generator-target="toggleButton"
            data-action="password-generator#toggleOptions"
          ></button>
        </div>

        <div class="password-generator-panel hidden" data-password-generator-target="panel">
          <label class="generator-length">
            Characters
            <span data-password-generator-target="lengthValue">20</span>
          </label>
          <input
            type="range"
            min="8"
            max="100"
            value="20"
            data-password-generator-target="length"
            data-action="password-generator#updateLength"
          >
          <label class="generator-option">
            Include numbers
            <input type="checkbox" checked data-password-generator-target="numbers">
          </label>
          <label class="generator-option">
            Include symbols
            <input type="checkbox" data-password-generator-target="symbols">
          </label>
          <button type="button" data-action="password-generator#generate">Use generated password</button>
        </div>
      </div>
    <% else %>
      <input id="credential_password_plaintext" type="password" required data-credential-form-target="password">
    <% end %>

    <label for="credential_notes_plaintext">Notes</label>
    <textarea id="credential_notes_plaintext" rows="3" data-credential-form-target="notes"></textarea>
  </div>

  <%= f.hidden_field :encrypted_secret_payload, data: { credential_form_target: "encryptedPayload" } %>
  <%= f.submit submit_label %>
<% end %>
