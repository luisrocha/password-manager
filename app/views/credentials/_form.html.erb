<% credential_form_data = {
  controller: "credential-form",
  action: "submit->credential-form#submit",
} %>
<% credential_form_data[:credential_form_encrypted_payload_value] = credential.encrypted_secret_payload if credential.encrypted_secret_payload.present? %>
<%
  label_class = "block text-sm font-medium text-slate-700"
  input_class = "block min-h-11 w-full rounded-md border border-slate-300 px-3 py-2 text-base shadow-sm focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20"
  primary_button_class = "inline-flex min-h-11 items-center justify-center rounded-md border border-teal-700 bg-teal-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-800"
  secondary_button_class = "inline-flex min-h-11 items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
%>

<%= form_with model: credential, data: credential_form_data do |f| %>
  <div class="space-y-5">
    <div class="grid gap-2 sm:grid-cols-[9rem_1fr] sm:items-center">
      <%= f.label :name, class: label_class %>
      <%= f.text_field :name, class: input_class, data: { credential_form_target: "name" } %>
    </div>

    <div class="grid gap-2 sm:grid-cols-[9rem_1fr] sm:items-center">
      <%= f.label :domain, class: label_class %>
      <%= f.text_field :domain, class: input_class, data: { credential_form_target: "domain" } %>
    </div>

    <div class="grid gap-2 sm:grid-cols-[9rem_1fr] sm:items-center">
      <%= f.label :category, class: label_class %>
      <%= f.select :category, Credential::CATEGORIES, {}, class: input_class %>
    </div>

    <div class="grid gap-2 sm:grid-cols-[9rem_1fr] sm:items-center">
      <label class="<%= label_class %>" for="credential_username_plaintext">Username</label>
      <input id="credential_username_plaintext" class="<%= input_class %>" type="text" data-credential-form-target="username">
    </div>

    <div class="grid gap-2 sm:grid-cols-[9rem_1fr] sm:items-start">
      <label class="<%= label_class %> sm:pt-2" for="credential_password_plaintext">Password</label>
      <% if local_assigns[:password_generator] %>
        <div
          class="min-w-0 space-y-3"
          data-controller="password-generator"
          data-password-generator-hidden-class="hidden"
        >
          <div class="flex min-w-0 items-center gap-2">
            <input
              id="credential_password_plaintext"
              class="<%= input_class %> min-w-0 flex-1"
              type="password"
              required
              data-credential-form-target="password"
              data-password-generator-target="password"
            >
            <button
              type="button"
              class="icon-button table-icon-button shrink-0 password-visibility-button"
              aria-label="Show password"
              title="Show password"
              data-password-generator-target="visibilityButton"
              data-action="password-generator#toggleVisibility"
            ></button>
            <button
              type="button"
              class="icon-button table-icon-button shrink-0 icon-sparkles generate-password-button"
              aria-expanded="false"
              aria-label="Generate password"
              title="Generate password"
              data-password-generator-target="toggleButton"
              data-action="password-generator#toggleOptions"
            ></button>
          </div>

          <div class="hidden rounded-md border border-slate-200 bg-slate-50 p-3" data-password-generator-target="panel">
            <label class="flex items-center justify-between text-sm text-slate-600">
              Characters
              <span class="font-semibold text-slate-950" data-password-generator-target="lengthValue">20</span>
            </label>
            <input
              class="mt-2 w-full accent-teal-700"
              type="range"
              min="8"
              max="100"
              value="20"
              data-password-generator-target="length"
              data-action="password-generator#updateLength"
            >
            <label class="mt-3 flex items-center gap-2 text-sm text-slate-600">
              <input class="rounded border-slate-300 text-teal-700 focus:ring-teal-600" type="checkbox" checked data-password-generator-target="numbers">
              Include numbers
            </label>
            <label class="mt-2 flex items-center gap-2 text-sm text-slate-600">
              <input class="rounded border-slate-300 text-teal-700 focus:ring-teal-600" type="checkbox" data-password-generator-target="symbols">
              Include symbols
            </label>
            <button class="<%= secondary_button_class %> mt-3 w-full sm:w-auto" type="button" data-action="password-generator#generate">Use generated password</button>
          </div>
        </div>
      <% else %>
        <input id="credential_password_plaintext" class="<%= input_class %>" type="password" required data-credential-form-target="password">
      <% end %>
    </div>

    <div class="grid gap-2 sm:grid-cols-[9rem_1fr] sm:items-start">
      <label class="<%= label_class %> sm:pt-2" for="credential_notes_plaintext">Notes</label>
      <textarea id="credential_notes_plaintext" class="<%= input_class %>" rows="4" data-credential-form-target="notes"></textarea>
    </div>
  </div>

  <%= f.hidden_field :encrypted_secret_payload, data: { credential_form_target: "encryptedPayload" } %>
  <div class="mt-6">
    <%= f.submit submit_label, class: "#{primary_button_class} w-full sm:w-auto" %>
  </div>
<% end %>
