<%
  table_header_class = "border-b border-slate-200 px-4 py-3 text-left text-xs font-semibold uppercase text-slate-600"
  table_cell_class = "border-b border-slate-200 px-4 py-3 align-top"
  mobile_label_class = "text-xs font-semibold uppercase text-slate-500"
%>

  <section id="credentials_index" class="rounded-lg border border-slate-200 bg-white shadow-sm">
    <div class="border-b border-slate-200 px-4 py-3">
      <h2 class="text-sm font-semibold text-slate-950">Stored Items (<%= credentials.count %>)</h2>
    </div>

    <% if credentials.empty? %>
      <p class="px-4 py-8 text-sm text-slate-600">No stored items yet.</p>
    <% else %>
      <div class="divide-y divide-slate-200 md:hidden">
        <% credentials.each do |credential| %>
          <details
            class="credential-card"
            data-controller="credential-reveal"
            data-credential-reveal-encrypted-payload-value="<%= credential.encrypted_secret_payload %>"
          >
            <summary class="credential-summary grid grid-cols-[minmax(0,1fr)_auto] gap-x-3 gap-y-1 px-4 py-3">
              <span class="truncate font-semibold text-slate-950"><%= credential.name.presence || "Untitled" %></span>
              <span class="icon-button icon-chevron-down chevron-icon credential-card-chevron justify-self-end text-slate-500" aria-hidden="true"></span>

              <span class="truncate text-sm text-slate-600"><%= credential.domain.presence || "No domain" %></span>
              <span aria-hidden="true"></span>

              <span class="truncate text-sm text-slate-950" data-credential-reveal-target="username">Decrypting...</span>
              <span class="inline-flex min-w-[5.75rem] items-center justify-end gap-2" data-copy-group>
                  <span class="copy-feedback hidden text-right" data-copy-status></span>
                  <button
                    type="button"
                    class="icon-button table-icon-button credential-field-button icon-copy"
                    aria-label="Copy username"
                    title="Copy username"
                    data-action="credential-reveal#copyUsername"
                  ></button>
              </span>
            </summary>

            <div class="px-4 pb-4">
              <dl class="space-y-3 border-t border-slate-200 pt-3">
                <div class="flex items-center justify-between gap-3">
                  <dt class="<%= mobile_label_class %>">Category</dt>
                  <dd><span class="inline-flex rounded-full bg-teal-50 px-2.5 py-1 text-xs font-semibold uppercase text-teal-800"><%= credential.category %></span></dd>
                </div>
                <div class="flex min-h-10 items-center justify-between gap-3">
                  <dt class="<%= mobile_label_class %>">Password</dt>
                  <dd class="inline-flex items-center gap-2" data-copy-group>
                    <span class="break-all text-sm text-slate-950" data-credential-reveal-target="password">Hidden</span>
                    <span class="copy-feedback hidden" data-copy-status></span>
                    <button
                      type="button"
                      class="icon-button table-icon-button credential-field-button icon-copy"
                      aria-label="Copy password"
                      title="Copy password"
                      data-action="credential-reveal#copyPassword"
                    ></button>
                    <button
                      type="button"
                      class="icon-button table-icon-button credential-field-button reveal-secret-button"
                      aria-label="Reveal password"
                      title="Reveal password"
                      data-credential-reveal-target="passwordButton"
                      data-action="credential-reveal#revealPassword"
                    ></button>
                  </dd>
                </div>
                <div class="flex min-h-10 items-center justify-between gap-3">
                  <dt class="<%= mobile_label_class %>">Notes</dt>
                  <dd class="inline-flex items-center gap-2">
                    <span class="break-all text-sm text-slate-950" data-credential-reveal-target="notes">Hidden</span>
                    <button
                      type="button"
                      class="icon-button table-icon-button credential-field-button reveal-secret-button"
                      aria-label="Reveal notes"
                      title="Reveal notes"
                      data-credential-reveal-target="notesButton"
                      data-action="credential-reveal#revealNotes"
                    ></button>
                  </dd>
                </div>
              </dl>

              <div class="mt-4 flex items-center gap-2">
                <%= link_to edit_credential_path(credential),
                  class: "icon-button table-icon-button icon-pencil action-link",
                  aria: { label: "Edit credential" },
                  title: "Edit credential" do %>
                  <span class="visually-hidden">Edit credential</span>
                <% end %>
                <%= button_to credential_path(credential),
                  method: :delete,
                  form: { class: "inline-form" },
                  data: { turbo_confirm: "Delete this credential?" },
                  class: "icon-button table-icon-button icon-trash action-danger",
                  aria: { label: "Delete credential" },
                  title: "Delete credential" do %>
                  <span class="visually-hidden">Delete credential</span>
                <% end %>
              </div>
            </div>
          </details>
        <% end %>
      </div>

      <div class="hidden overflow-x-auto md:block">
        <table class="w-full min-w-[64rem] table-fixed border-collapse">
          <colgroup>
            <col class="w-[24%]">
            <col class="w-[11%]">
            <col class="w-[18%]">
            <col class="w-[18%]">
            <col class="w-[19%]">
            <col class="w-[10%]">
          </colgroup>
          <thead class="bg-slate-50">
            <tr>
              <th class="<%= table_header_class %>">Item</th>
              <th class="<%= table_header_class %>">Category</th>
              <th class="<%= table_header_class %>">Username</th>
              <th class="<%= table_header_class %>">Password</th>
              <th class="<%= table_header_class %>">Notes</th>
              <th class="<%= table_header_class %>">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% credentials.each do |credential| %>
              <tr
                data-controller="credential-reveal"
                data-credential-reveal-encrypted-payload-value="<%= credential.encrypted_secret_payload %>"
              >
                <td class="<%= table_cell_class %>">
                  <div class="font-semibold text-slate-950"><%= credential.name.presence || "Untitled" %></div>
                  <div class="mt-1 break-all text-sm text-slate-600"><%= credential.domain.presence || "No domain" %></div>
                </td>
                <td class="<%= table_cell_class %>">
                  <span class="inline-flex rounded-full bg-teal-50 px-2.5 py-1 text-xs font-semibold uppercase text-teal-800"><%= credential.category %></span>
                </td>
                <td class="<%= table_cell_class %>">
                  <span class="flex items-center justify-between gap-2" data-copy-group>
                    <span class="break-all text-sm text-slate-950" data-credential-reveal-target="username">Decrypting...</span>
                    <span class="inline-flex shrink-0 items-center gap-2">
                      <span class="copy-feedback hidden" data-copy-status></span>
                      <button
                        type="button"
                        class="icon-button table-icon-button credential-field-button icon-copy"
                        aria-label="Copy username"
                        title="Copy username"
                        data-action="credential-reveal#copyUsername"
                      ></button>
                    </span>
                  </span>
                </td>
                <td class="<%= table_cell_class %>">
                  <span class="flex items-center justify-between gap-2" data-copy-group>
                    <span class="break-all text-sm text-slate-950" data-credential-reveal-target="password">Hidden</span>
                    <span class="inline-flex shrink-0 items-center gap-2">
                      <span class="copy-feedback hidden" data-copy-status></span>
                      <button
                        type="button"
                        class="icon-button table-icon-button credential-field-button icon-copy"
                        aria-label="Copy password"
                        title="Copy password"
                        data-action="credential-reveal#copyPassword"
                      ></button>
                      <button
                        type="button"
                        class="icon-button table-icon-button credential-field-button reveal-secret-button"
                        aria-label="Reveal password"
                        title="Reveal password"
                        data-credential-reveal-target="passwordButton"
                        data-action="credential-reveal#revealPassword"
                      ></button>
                    </span>
                  </span>
                </td>
                <td class="<%= table_cell_class %>">
                  <span class="inline-flex items-center gap-2">
                    <span class="break-all text-sm text-slate-950" data-credential-reveal-target="notes">Hidden</span>
                    <button
                      type="button"
                      class="icon-button table-icon-button credential-field-button reveal-secret-button"
                      aria-label="Reveal notes"
                      title="Reveal notes"
                      data-credential-reveal-target="notesButton"
                      data-action="credential-reveal#revealNotes"
                    ></button>
                  </span>
                </td>
                <td class="<%= table_cell_class %>">
                  <div class="flex items-center gap-2 md:justify-start">
                    <%= link_to edit_credential_path(credential),
                      class: "icon-button table-icon-button icon-pencil action-link",
                      aria: { label: "Edit credential" },
                      title: "Edit credential" do %>
                      <span class="visually-hidden">Edit credential</span>
                    <% end %>
                    <%= button_to credential_path(credential),
                      method: :delete,
                      form: { class: "inline-form" },
                      data: { turbo_confirm: "Delete this credential?" },
                      class: "icon-button table-icon-button icon-trash action-danger",
                      aria: { label: "Delete credential" },
                      title: "Delete credential" do %>
                      <span class="visually-hidden">Delete credential</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
