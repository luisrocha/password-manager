<% content_for :title, "Import / Export" %>
<%
  primary_button_class = "inline-flex min-h-11 items-center justify-center rounded-md border border-teal-700 bg-teal-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-800"
  secondary_button_class = "inline-flex min-h-11 items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
  input_class = "block min-h-11 w-full rounded-md border border-slate-300 px-3 py-2 text-base shadow-sm focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20"
%>

<main class="mx-auto w-full max-w-3xl px-4 py-6 sm:px-6 lg:px-8"
  data-controller="credential-import"
  data-credential-import-export-url-value="<%= export_credentials_path %>">
  <header class="mb-5 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div class="space-y-2">
      <h1 class="text-3xl font-semibold text-slate-950">Import / Export</h1>
    </div>
    <%= link_to "Back to list", credentials_path, class: secondary_button_class %>
  </header>

  <% if notice.present? %>
    <p class="mb-4 rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-900"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800"><%= alert %></p>
  <% end %>

  <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <div class="space-y-1">
      <h2 class="text-lg font-semibold text-slate-950">Import CSV</h2>
      <p class="text-sm leading-6 text-slate-600">Upload an exported 1Password CSV file to add items to the vault.</p>
    </div>

    <%= form_with url: import_credentials_path,
      method: :post,
      multipart: true,
      class: "mt-5",
      data: { action: "submit->credential-import#submit" } do |f| %>
      <div class="space-y-2">
        <%= f.file_field :file,
          accept: ".csv,text/csv",
          required: true,
          class: "block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-slate-700 hover:file:bg-slate-200 focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20",
          data: { credential_import_target: "file" } %>
      </div>

      <div data-credential-import-target="fields"></div>
      <p class="hidden" data-credential-import-target="status"></p>

      <div class="mt-6">
        <%= f.submit "Import", class: "#{primary_button_class} w-full sm:w-auto" %>
      </div>
    <% end %>
  </section>

  <section class="mt-4 rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <div class="space-y-1">
      <h2 class="text-lg font-semibold text-slate-950">Export CSV</h2>
      <p class="text-sm leading-6 text-slate-600">Download your current vault in the same CSV format used for imports.</p>
    </div>

    <div class="mt-6">
      <button type="button"
        class="<%= primary_button_class %> w-full disabled:cursor-not-allowed disabled:border-slate-300 disabled:bg-slate-200 disabled:text-slate-500 sm:w-auto"
        data-action="credential-import#export">
        Export
      </button>
    </div>

  </section>

  <dialog class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-md rounded-lg border border-slate-200 bg-white p-0 text-slate-950 shadow-xl backdrop:bg-slate-950/40" data-credential-import-target="exportModal">
    <form class="space-y-4 p-5 sm:p-6" data-action="submit->credential-import#confirmExport">
      <div class="space-y-1">
        <h2 class="text-lg font-semibold">Confirm export</h2>
        <p class="text-sm leading-6 text-slate-600">
          Re-enter your master password<%= " and two-factor code" if @totp_enabled %> before exporting plaintext credentials.
        </p>
      </div>

      <p class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
        The exported CSV contains plaintext secrets. Store it carefully and delete it when you no longer need it.
      </p>

      <div class="space-y-2">
        <label class="text-sm font-medium text-slate-700" for="credential_export_master_password">Master password</label>
        <input id="credential_export_master_password" type="password" autocomplete="current-password" required class="<%= input_class %>" data-credential-import-target="exportMasterPassword">
      </div>

      <% if @totp_enabled %>
        <div class="space-y-2">
          <label class="text-sm font-medium text-slate-700" for="credential_export_two_factor_code">Two-factor code</label>
          <input id="credential_export_two_factor_code" type="text" inputmode="text" autocomplete="one-time-code" required placeholder="Code or recovery code" class="<%= input_class %>" data-credential-import-target="exportTwoFactorCode">
        </div>
      <% end %>

      <p class="hidden" data-credential-import-target="exportStatus"></p>

      <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
        <button type="button" class="<%= secondary_button_class %>" data-action="credential-import#closeExportModal">Cancel</button>
        <button type="submit" class="<%= primary_button_class %>">Export CSV</button>
      </div>
    </form>
  </dialog>
</main>
