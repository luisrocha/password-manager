<% content_for :title, "Password Manager" %>

<main class="credentials-page">
  <header>
    <h1>Password Manager</h1>
    <p>Search credentials by name or domain and reveal secret fields only when needed.</p>
    <nav class="page-actions" aria-label="Credential actions">
      <%= link_to "Add Item", new_credential_path, class: "button-link" %>
      <%= link_to "Import CSV", import_credentials_path, class: "button-link secondary-button-link" %>
      <%= button_to "Lock Vault", lock_path, method: :delete, form: { class: "inline-form", data: { controller: "lock", action: "submit->lock#clear" } } %>
    </nav>
  </header>

  <% if notice.present? %>
    <p class="flash notice"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="flash alert"><%= alert %></p>
  <% end %>

  <section class="panel">
    <h2>Search</h2>
    <%= form_with url: credentials_path, method: :get, local: true do |f| %>
      <%= f.search_field :q, value: @query, placeholder: "Search by name or domain" %>
      <%= f.submit "Search" %>
      <%= link_to "Clear", credentials_path %>
    <% end %>
  </section>

  <section class="panel">
    <h2>Stored Items (<%= @credentials.count %>)</h2>
    <% if @credentials.empty? %>
      <p class="empty-state">No stored items yet.</p>
    <% else %>
      <div class="table-wrap">
        <table class="stored-items-table">
          <thead>
            <tr>
              <th>Item</th>
              <th>Category</th>
              <th>Username</th>
              <th>Password</th>
              <th>Notes</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @credentials.each do |credential| %>
              <tr
                data-controller="credential-reveal"
                data-credential-reveal-encrypted-payload-value="<%= credential.encrypted_secret_payload %>"
              >
                <td>
                  <div class="item-main"><%= credential.name %></div>
                  <div class="item-sub"><%= credential.domain.presence || "No domain" %></div>
                </td>
                <td>
                  <span class="category-pill"><%= credential.category %></span>
                </td>
                <td>
                  <span data-credential-reveal-target="username">Decrypting...</span>
                </td>
                <td>
                  <span data-credential-reveal-target="password">Hidden</span>
                  <button
                    type="button"
                    class="icon-button table-icon-button reveal-secret-button"
                    style="--show-icon-url: url('<%= asset_path("icons/eye.svg") %>'); --hide-icon-url: url('<%= asset_path("icons/eye-off.svg") %>')"
                    aria-label="Reveal password"
                    title="Reveal password"
                    data-credential-reveal-target="passwordButton"
                    data-action="credential-reveal#revealPassword"
                  ></button>
                </td>
                <td>
                  <span data-credential-reveal-target="notes">Hidden</span>
                  <button
                    type="button"
                    class="icon-button table-icon-button reveal-secret-button"
                    style="--show-icon-url: url('<%= asset_path("icons/eye.svg") %>'); --hide-icon-url: url('<%= asset_path("icons/eye-off.svg") %>')"
                    aria-label="Reveal notes"
                    title="Reveal notes"
                    data-credential-reveal-target="notesButton"
                    data-action="credential-reveal#revealNotes"
                  ></button>
                </td>
                <td class="actions">
                  <div class="actions-inner">
                    <%= link_to edit_credential_path(credential),
                      class: "icon-button table-icon-button action-link",
                      style: "--icon-url: url('#{asset_path('icons/pencil.svg')}')",
                      aria: { label: "Edit credential" },
                      title: "Edit credential" do %>
                      <span class="visually-hidden">Edit credential</span>
                    <% end %>
                    <%= button_to credential_path(credential),
                      method: :delete,
                      form: { class: "inline-form" },
                      data: { turbo_confirm: "Delete this credential?" },
                      class: "icon-button table-icon-button action-danger",
                      style: "--icon-url: url('#{asset_path('icons/trash.svg')}')",
                      aria: { label: "Delete credential" },
                      title: "Delete credential" do %>
                      <span class="visually-hidden">Delete credential</span>
                    <% end %>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </section>
</main>
