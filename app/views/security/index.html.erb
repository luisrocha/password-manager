<% content_for :title, "2FA Settings" %>
<%
  primary_button_class = "inline-flex min-h-11 items-center justify-center rounded-md border border-teal-700 bg-teal-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-800"
  secondary_button_class = "inline-flex min-h-11 items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
  danger_button_class = "inline-flex min-h-11 items-center justify-center rounded-md border border-red-700 bg-red-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-800"
%>

<main class="mx-auto w-full max-w-2xl px-4 py-6 sm:px-6 lg:px-8">
  <header class="mb-5 flex items-center justify-between gap-4">
    <div>
      <p class="text-sm font-semibold uppercase text-teal-700">Vault settings</p>
      <h1 class="text-3xl font-semibold text-slate-950">Two-factor Authentication</h1>
    </div>

    <%= link_to "Back", credentials_path, class: secondary_button_class %>
  </header>

  <% if notice.present? %>
    <p class="mb-4 rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-900"><%= notice %></p>
  <% end %>
  <% if alert.present? %>
    <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800"><%= alert %></p>
  <% end %>

  <section class="rounded-lg border border-slate-200 bg-white p-4 shadow-sm sm:p-5">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <h2 class="text-base font-semibold text-slate-950">Two-factor unlock</h2>
        <p class="mt-1 text-sm leading-6 text-slate-600">Require a six-digit authenticator code after the master password unlock proof.</p>
      </div>

      <% if @totp_setting&.enabled? %>
        <%= button_to "Disable", totp_setting_path,
          method: :delete,
          form: { data: { turbo_confirm: "Disable two-factor unlock?" } },
          class: danger_button_class %>
      <% elsif @pending_totp_setting.blank? %>
        <%= button_to "Enable", totp_setting_path, method: :post, class: primary_button_class %>
      <% end %>
    </div>

    <% if @totp_setting&.enabled? %>
      <p class="mt-5 rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-900">Two-factor unlock is enabled.</p>
    <% elsif @pending_totp_setting.present? %>
      <div class="mt-5 space-y-4 border-t border-slate-200 pt-5">
        <div class="inline-block rounded-md border border-slate-200 bg-white p-3">
          <%= RQRCode::QRCode.new(@pending_totp_setting.provisioning_uri).as_svg(
            color: "000",
            fill: "fff",
            module_size: 4,
            shape_rendering: "crispEdges",
            standalone: true,
            use_path: true
          ).html_safe %>
        </div>

        <p class="text-sm text-slate-600">Scan the QR code with your authenticator app, then enter the generated code.</p>
        <p class="rounded-md bg-slate-50 px-3 py-2 font-mono text-sm text-slate-800"><%= @pending_totp_setting.secret %></p>

        <%= form_with url: confirm_totp_setting_path, method: :post, local: true, html: { class: "flex flex-col gap-3 sm:flex-row" } do |f| %>
          <%= f.text_field :code, required: true, inputmode: "numeric", pattern: "[0-9 ]*", autocomplete: "one-time-code", placeholder: "Six-digit code", aria: { label: "Two-factor code" }, class: "block min-h-11 w-full rounded-md border border-slate-300 px-3 py-2 text-base shadow-sm focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20" %>
          <%= f.submit "Confirm", class: primary_button_class %>
        <% end %>
      </div>
    <% else %>
      <p class="mt-5 rounded-md border border-slate-200 bg-slate-50 px-3 py-2 text-sm text-slate-600">Two-factor unlock is not enabled.</p>
    <% end %>
  </section>
</main>
