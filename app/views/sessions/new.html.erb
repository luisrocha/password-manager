<% content_for :title, "Password Manager" %>

<main class="credentials-page" data-controller="unlock">
  <div
    class="hidden"
    data-unlock-target="challenge"
    data-challenge="<%= session[:unlock_challenge] %>"
    data-vault-registered="<%= @vault_registered %>"
  ></div>

  <section class="panel">
    <h1>Password Manager</h1>
    <p data-unlock-target="description">Preparing vault unlock.</p>

    <% if notice.present? %>
      <p class="flash notice"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p class="flash alert"><%= alert %></p>
    <% end %>

    <div class="unlock-flow hidden" data-unlock-target="flow">
      <p class="hidden" data-unlock-target="status"></p>

      <div class="vault-panel hidden" data-unlock-target="setupPanel">
        <h2 data-unlock-target="setupTitle">Create vault key</h2>

        <%= form_with url: unlock_path, method: :post, local: true, data: { action: "submit->unlock#setup", unlock_target: "setupForm" } do |f| %>
          <div class="grid">
            <%= f.label :setup_master_password, "New master password" %>
            <%= f.password_field :setup_master_password, required: true, autocomplete: "new-password", data: { unlock_target: "setupPassword" } %>

            <%= f.label :setup_master_password_confirmation, "Confirm master password" %>
            <%= f.password_field :setup_master_password_confirmation, required: true, autocomplete: "new-password", data: { unlock_target: "setupConfirmation" } %>
          </div>

          <div class="form-actions">
            <%= f.submit "Create Vault Key" %>
            <%= link_to "Import backup", "#", data: { action: "unlock#showImport" } %>
          </div>
        <% end %>

        <div class="form-actions">
          <a
            class="button-link hidden"
            download="password-manager-vault-backup.json"
            data-unlock-target="backupDownload"
          >Download Backup</a>
          <button
            type="button"
            class="secondary-button-link hidden"
            data-unlock-target="continueButton"
            data-action="unlock#continueToVault"
          >Continue to Vault</button>
        </div>
      </div>

      <div class="vault-panel hidden" data-unlock-target="unlockPanel">
        <h2>Unlock vault</h2>

        <%= form_with url: unlock_path, method: :post, local: true, data: { action: "submit->unlock#unlock" } do |f| %>
          <div class="grid">
            <%= f.label :local_master_password, "Master password" %>
            <%= f.password_field :local_master_password, required: true, autofocus: true, autocomplete: "current-password", data: { unlock_target: "unlockPassword" } %>
          </div>

          <div class="form-actions">
            <%= f.submit "Unlock" %>
            <%= link_to "Import backup", "#", data: { action: "unlock#showImport" } %>
          </div>
        <% end %>
      </div>

      <div class="vault-panel hidden" data-unlock-target="importPanel">
        <h2>Import vault backup</h2>

        <form data-action="submit->unlock#importBackup">
          <div class="grid">
            <label for="vault_backup_file">Backup file</label>
            <input id="vault_backup_file" type="file" accept="application/json,.json" required data-unlock-target="backupFile">
          </div>

          <div class="form-actions">
            <button type="submit">Import Backup</button>
            <button type="button" class="secondary-button-link" data-unlock-target="cancelImportButton" data-action="unlock#cancelImport">Cancel</button>
            <% unless @vault_registered %>
              <%= link_to "Create new key", "#", data: { action: "unlock#showSetup" } %>
            <% end %>
          </div>
        </form>
      </div>
    </div>

    <%= form_with url: unlock_path, method: :post, html: { class: "hidden" }, data: { unlock_target: "sessionForm" } do |f| %>
      <%= f.hidden_field :unlock_signature, data: { unlock_target: "signature" } %>
      <%= f.hidden_field :signing_public_key_spki, data: { unlock_target: "signingPublicKey" } %>
    <% end %>
  </section>
</main>
