<% content_for :title, "Password Manager" %>

<main class="mx-auto flex min-h-screen w-full max-w-lg items-center px-4 py-8 sm:px-6" data-controller="unlock">
  <div
    class="hidden"
    data-unlock-target="challenge"
    data-challenge="<%= session[:unlock_challenge] %>"
    data-vault-registered="<%= @vault_registered %>"
    data-setup-token-required="<%= @setup_token_required %>"
    data-enforce-password-strength="<%= Rails.env.production? %>"
  ></div>

  <section class="w-full rounded-lg border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
    <div class="mb-6 space-y-2">
      <h1 class="text-3xl font-semibold text-slate-950">Password Manager</h1>
      <p class="text-sm leading-6 text-slate-600" data-unlock-target="description">Preparing vault unlock.</p>
    </div>

    <% if notice.present? %>
      <p class="mb-4 rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-900"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800"><%= alert %></p>
    <% end %>

    <div class="hidden space-y-5" data-unlock-target="flow">
      <p class="hidden" data-unlock-target="status"></p>

      <div class="hidden space-y-4" data-unlock-target="setupPanel">
        <span class="hidden" data-unlock-target="setupTitle">Create vault key</span>

        <%= form_with url: unlock_path, method: :post, local: true, data: { action: "submit->unlock#setup", unlock_target: "setupForm" } do |f| %>
          <div class="space-y-4">
            <%= f.password_field :setup_master_password, required: true, minlength: (14 if Rails.env.production?), autocomplete: "new-password", placeholder: "New master password", aria: { label: "New master password" }, class: "block w-full rounded-md border-slate-300 px-3 py-2 text-base shadow-sm focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20", data: { unlock_target: "setupPassword" } %>

            <%= f.password_field :setup_master_password_confirmation, required: true, minlength: (14 if Rails.env.production?), autocomplete: "new-password", placeholder: "Confirm master password", aria: { label: "Confirm master password" }, class: "block w-full rounded-md border-slate-300 px-3 py-2 text-base shadow-sm focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20", data: { unlock_target: "setupConfirmation" } %>

            <% if @setup_token_required %>
              <%= f.password_field :setup_token, required: true, autocomplete: "one-time-code", placeholder: "Setup token", aria: { label: "Setup token" }, class: "block w-full rounded-md border-slate-300 px-3 py-2 text-base shadow-sm focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20", data: { unlock_target: "setupToken" } %>
            <% end %>
          </div>

          <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center">
            <%= f.submit "Create Vault Key", class: "inline-flex min-h-11 items-center justify-center rounded-md border border-teal-700 bg-teal-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-800" %>
            <%= link_to "Import backup", "#", class: "inline-flex min-h-11 items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50", data: { action: "unlock#showImport" } %>
          </div>
        <% end %>

        <div class="hidden flex-col gap-3 sm:flex-row sm:items-center" data-unlock-target="backupActions">
          <a
            class="inline-flex min-h-11 items-center justify-center rounded-md border border-teal-700 bg-teal-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-800"
            download="password-manager-vault-backup.json"
            data-unlock-target="backupDownload"
          >Download Backup</a>
          <button
            type="button"
            class="inline-flex min-h-11 items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
            data-unlock-target="continueButton"
            data-action="unlock#continueToVault"
          >Continue to Vault</button>
        </div>
      </div>

      <div class="hidden space-y-4" data-unlock-target="unlockPanel">
        <%= form_with url: unlock_path, method: :post, local: true, data: { action: "submit->unlock#unlock" } do |f| %>
          <div class="space-y-4">
            <%= f.password_field :local_master_password, required: true, autofocus: true, autocomplete: "current-password", placeholder: "Master password", aria: { label: "Master password" }, class: "block w-full rounded-md border-slate-300 px-3 py-2 text-base shadow-sm focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20", data: { unlock_target: "unlockPassword" } %>

            <% if @setup_token_required %>
              <%= f.password_field :setup_token, required: true, autocomplete: "one-time-code", placeholder: "Setup token", aria: { label: "Setup token" }, class: "block w-full rounded-md border-slate-300 px-3 py-2 text-base shadow-sm focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20", data: { unlock_target: "setupToken" } %>
            <% end %>
          </div>

          <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center">
            <%= f.submit "Unlock", class: "inline-flex min-h-11 items-center justify-center rounded-md border border-teal-700 bg-teal-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-800" %>
            <%= link_to "Import backup", "#", class: "inline-flex min-h-11 items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50", data: { action: "unlock#showImport" } %>
          </div>
        <% end %>
      </div>

      <div class="hidden space-y-4" data-unlock-target="importPanel">
        <form data-action="submit->unlock#importBackup">
          <input class="block w-full rounded-md border border-slate-300 px-3 py-2 text-sm shadow-sm file:mr-3 file:rounded-md file:border-0 file:bg-slate-100 file:px-3 file:py-1.5 file:text-sm file:font-semibold file:text-slate-700 hover:file:bg-slate-200 focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20" id="vault_backup_file" type="file" accept="application/json,.json" required aria-label="Backup file" data-unlock-target="backupFile">

          <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center">
            <button class="inline-flex min-h-11 items-center justify-center rounded-md border border-teal-700 bg-teal-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-800" type="submit">Import Backup</button>
            <button type="button" class="inline-flex min-h-11 items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50" data-unlock-target="cancelImportButton" data-action="unlock#cancelImport">Cancel</button>
            <% unless @vault_registered %>
              <%= link_to "Create new key", "#", class: "inline-flex min-h-11 items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50", data: { action: "unlock#showSetup" } %>
            <% end %>
          </div>
        </form>
      </div>
    </div>

    <%= form_with url: unlock_path, method: :post, html: { class: "hidden" }, data: { unlock_target: "sessionForm" } do |f| %>
      <%= f.hidden_field :unlock_signature, data: { unlock_target: "signature" } %>
      <%= f.hidden_field :signing_public_key_spki, data: { unlock_target: "signingPublicKey" } %>
      <%= f.hidden_field :setup_token, data: { unlock_target: "sessionSetupToken" } %>
    <% end %>
  </section>
</main>
