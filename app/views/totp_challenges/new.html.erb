<% content_for :title, "Two-factor unlock" %>
<%
  primary_button_class = "inline-flex min-h-11 items-center justify-center rounded-md border border-teal-700 bg-teal-700 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-teal-800"
  secondary_button_class = "inline-flex min-h-11 items-center justify-center rounded-md border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-50"
%>

<main class="mx-auto flex min-h-screen w-full max-w-md items-center px-4 py-8 sm:px-6">
  <section class="w-full rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
    <div class="mb-5">
      <p class="text-sm font-semibold uppercase text-teal-700">Vault locked</p>
      <h1 class="text-3xl font-semibold text-slate-950">Two-factor unlock</h1>
      <p class="mt-2 text-sm leading-6 text-slate-600">Enter the code from your authenticator app to finish unlocking.</p>
    </div>

    <% if notice.present? %>
      <p class="mb-4 rounded-md border border-emerald-200 bg-emerald-50 px-3 py-2 text-sm text-emerald-900"><%= notice %></p>
    <% end %>
    <% if alert.present? %>
      <p class="mb-4 rounded-md border border-red-200 bg-red-50 px-3 py-2 text-sm text-red-800"><%= alert %></p>
    <% end %>

    <%= form_with url: totp_challenge_path, method: :post, local: true, html: { class: "space-y-4" } do |f| %>
      <%= f.text_field :code, required: true, autofocus: true, inputmode: "numeric", pattern: "[0-9 ]*", autocomplete: "one-time-code", placeholder: "Six-digit code", aria: { label: "Two-factor code" }, class: "block min-h-11 w-full rounded-md border border-slate-300 px-3 py-2 text-base shadow-sm focus:border-teal-600 focus:outline-none focus:ring-2 focus:ring-teal-600/20" %>
      <div class="flex flex-col gap-3 sm:flex-row">
        <%= f.submit "Unlock", class: "#{primary_button_class} sm:flex-1" %>
        <%= link_to "Cancel", unlock_path, class: secondary_button_class %>
      </div>
    <% end %>
  </section>
</main>
