PASSWORD_MANAGER_HOST=vault.localhost
# Optional comma-separated extra hostnames or IP addresses allowed by Rails host
# authorization, for example: 192.168.1.50,password-manager.local
PASSWORD_MANAGER_ADDITIONAL_HOSTS=
PASSWORD_MANAGER_HTTP_PORT=80
PASSWORD_MANAGER_HTTPS_PORT=443

# Generate with: bin/rails secret
SECRET_KEY_BASE=replace-with-a-generated-secret

# Required before the first vault key is registered.
PASSWORD_MANAGER_SETUP_TOKEN=replace-with-a-setup-token

# Optional web vault session duration after unlock.
PASSWORD_MANAGER_VAULT_SESSION_TTL_MINUTES=30

# Required when using the browser extension API. Generate a high-entropy token,
# store the token in the extension, and store only its SHA-256 hash here.
PASSWORD_MANAGER_API_TOKEN_SHA256_HASHES=replace-with-token-sha256-hash
