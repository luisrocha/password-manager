PASSWORD_MANAGER_HOST=vault.localhost
PASSWORD_MANAGER_HTTP_PORT=80
PASSWORD_MANAGER_HTTPS_PORT=443

# Generate with: bin/rails secret
SECRET_KEY_BASE=replace-with-a-generated-secret

# Required before the first vault key is registered.
PASSWORD_MANAGER_SETUP_TOKEN=replace-with-a-setup-token

# Optional web vault session duration after unlock.
PASSWORD_MANAGER_VAULT_SESSION_TTL_MINUTES=30

# Required when using the browser extension API.
PASSWORD_MANAGER_API_TOKEN=replace-with-a-generated-token
